@{
    Layout = "_Layout";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Overview";
}

<div class="app-container">
    <div id="landlord-dashboard" class="dashboard">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2><i class="fas fa-user-shield"></i> Landlord</h2>
            <nav>
                <ul>
                    <li><a asp-action="Overview" asp-controller="Landlord" class="nav-link @(currentAction == "Overview" ? "active" : "")"><i class="fas fa-tachometer-alt"></i> Overview</a></li>
                    <li><a asp-action="ManageBuildings" asp-controller="Landlord" class="nav-link @(currentAction == "ManageBuildings" ? "active" : "")"><i class="fas fa-building"></i> Manage Buildings</a></li>
                    <li><a asp-action="ManageTenants" asp-controller="Landlord" class="nav-link @(currentAction == "ManageTenants" ? "active" : "")"><i class="fas fa-users"></i> Manage Tenants</a></li>
                    <li><a asp-action="AddTenant" asp-controller="Landlord" class="nav-link @(currentAction == "AddTenant" ? "active" : "")"><i class="fas fa-user-plus"></i> Add Tenant</a></li>
                    <li><a asp-action="MeterReadings" asp-controller="Landlord" class="nav-link @(currentAction == "MeterReadings" ? "active" : "")"><i class="fas fa-bolt"></i> Meter Readings</a></li>
                    <li><a asp-action="Billing" asp-controller="Landlord" class="nav-link @(currentAction == "Billing" ? "active" : "")"><i class="fas fa-file-invoice-dollar"></i> Billing & Payments</a></li>
                    <li><a asp-action="Reports" asp-controller="Landlord" class="nav-link @(currentAction == "Reports" ? "active" : "")"><i class="fas fa-chart-line"></i> Reports</a></li>
                </ul>
            </nav>
            <div class="logout-button">
                @* Wrap button in a form to POST to the Logout action *@
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area - Rendered by Specific Views -->
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- Update Fees Modal (Shared for Landlord section) -->
        <div id="update-fees-modal" class="modal">
            <div class="modal-content">
                <span class="close-btn" onclick="closeUpdateFeesModal()">×</span>
                <div class="modal-header"><h4 id="update-fees-tenant-name">Update Tenant Fees</h4></div>
                <form id="update-fees-form">
                    @* @Html.AntiForgeryToken() *@
                    <input type="hidden" id="update-fees-tenant-id">
                    <p style="font-size: 0.9em; color: #555; margin-bottom: 15px;">Enter new values to override building defaults for this tenant ONLY. Leave blank to keep current override/default.</p>
                    <div class="form-grid">
                        <div class="form-group"><label for="new-rent-fee">Specific Rent Fee (₱)</label><input type="number" step="0.01" id="new-rent-fee" placeholder="e.g., 2800 or blank"></div>
                        <div class="form-group"><label for="new-water-fee">Specific Water Fee (₱)</label><input type="number" step="0.01" id="new-water-fee" placeholder="e.g., 125 or blank"></div>
                        <div class="form-group"><label for="new-wifi-fee">Specific WiFi Fee (₱)</label><input type="number" step="0.01" id="new-wifi-fee" placeholder="e.g., 210 or blank"></div>
                    </div>
                    <p style="font-size: 0.9em; color: #555; margin-bottom: 15px;">Changes apply next billing cycle. Tenant notified.</p>
                    <button type="submit">Save Tenant Fee Changes</button>
                    <button type="button" class="btn-secondary" onclick="closeUpdateFeesModal()">Cancel</button>
                    <p id="update-fees-message" class="message success"></p>
                </form>
            </div>
        </div>

    </div>
</div>