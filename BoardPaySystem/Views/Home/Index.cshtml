@model BoardPaySystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div>

<div class="app-container">
    <div id="login-view">
        <h1><i class="fas fa-door-open"></i> Boarding House Login</h1>
            @* Use Tag Helpers for the form *@
            <form id="login-form" asp-controller="Account" asp-action="Login" method="post">

            @* @Html.AntiForgeryToken() *@

                @* Display general validation errors (like "Invalid login attempt") *@
                <div asp-validation-summary="ModelOnly" class="message error" style="display: block;"></div>

                @* Display ViewBag error if set *@
                @if (ViewBag.LoginError != null)
                {
                    <p class="message error" style="display: block;">@ViewBag.LoginError</p>
                }
                <div class="form-group">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" id="username" class="form-control" placeholder="Enter your username" />
                    @* Display validation error for Username *@
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" id="password" class="form-control" placeholder="Enter your password" />
                    @* Display validation error for Password *@
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Role">Login As</label>
                    <select asp-for="Role" id="role" class="form-control">
                        <option value="" disabled selected>-- Select Role --</option>
                        @* Values should match Role.Name in your database EXACTLY (case-insensitive check handles it later) *@
                        <option value="Landlord">Landlord/Admin</option>
                        <option value="Tenant">Tenant</option>
                    </select>
                    @* Display validation error for Role *@
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <button type="submit">Login</button>

                @* Remove the old JS-based error paragraph if not needed *@
                 <p id="login-error" class="message error"></p> 
        </form>
    </div>
</div>

</div>
