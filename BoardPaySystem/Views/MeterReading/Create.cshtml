@{
    ViewData["Title"] = "Record Meter Reading";
    Layout = "_LandlordLayout";
    var tenants = ViewBag.Tenants as List<BoardPaySystem.Models.ApplicationUser>;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Meter Readings</a></li>
                    <li class="breadcrumb-item active">Record New Reading</li>
                </ol>
            </nav>
            <h1><i class="fas fa-bolt"></i> Record Meter Reading</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Reading Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group mb-3">
                            <label for="tenantId" class="form-label required">Select Tenant</label>
                            <select id="tenantId" name="tenantId" class="form-select" required>
                                <option value="">-- Choose Tenant --</option>
                                @foreach (var tenant in tenants)
                                {
                                    <option value="@tenant.Id">
                                        @tenant.FirstName @tenant.LastName 
                                        (@tenant.Room.Floor.Building.BuildingName - Room @tenant.Room.RoomNumber)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="readingDate" class="form-label required">Reading Date</label>
                            <input type="date" id="readingDate" name="readingDate" class="form-control" 
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="form-group mb-3">
                            <label for="currentReading" class="form-label required">Current Reading (kWh)</label>
                            <input type="number" id="currentReading" name="currentReading" class="form-control" 
                                   step="0.01" min="0.01" placeholder="e.g., 55.75" required />
                            <small class="form-text text-muted">
                                Enter the current meter reading in kilowatt-hours (kWh). This should be the total reading shown on the electric meter.
                            </small>
                        </div>

                        <div class="form-group mb-3">
                            <label for="notes" class="form-label">Notes</label>
                            <textarea id="notes" name="notes" class="form-control" rows="3" 
                                      placeholder="Optional notes about this reading"></textarea>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Record Reading
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Reading Instructions</h5>
                </div>
                <div class="card-body">
                    <p><strong>How to take a meter reading:</strong></p>
                    <ol>
                        <li>Locate the electric meter for the tenant's room.</li>
                        <li>Read the numbers shown on the digital display or dials.</li>
                        <li>For digital meters, record all numbers shown (including any decimal places).</li>
                        <li>For analog meters with dials, read from left to right.</li>
                        <li>Enter the complete reading in kilowatt-hours (kWh).</li>
                    </ol>
                    
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Important:</strong>
                        <p class="mb-0">Always record the full meter reading, not just the difference from the last reading. The system will automatically calculate usage.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set maximum date for the date picker to today
            const today = new Date().toISOString().split('T')[0];
            $('#readingDate').attr('max', today);
            
            // Add validation
            $('form').on('submit', function(e) {
                if ($('#tenantId').val() === '') {
                    alert('Please select a tenant');
                    e.preventDefault();
                    return false;
                }
                
                if ($('#currentReading').val() <= 0) {
                    alert('Reading value must be greater than zero');
                    e.preventDefault();
                    return false;
                }
                
                return true;
            });
        });
    </script>
}