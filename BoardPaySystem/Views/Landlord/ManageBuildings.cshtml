@{
    ViewData["Title"] = "Manage Buildings";
    Layout = "_LandlordLayout";
}

<h3>
    <span><i class="fas fa-building"></i> Manage Buildings</span>
    <span class="actions"><button class="btn-success btn-small" onclick="showAddBuildingForm()">Add New Building</button></span>
</h3>

@* Add Building Form (hidden initially) *@
<div id="add-building-form-container" style="display:none; margin-bottom: 20px; padding: 20px; background: #f9f9f9; border-radius: 5px;">
    <h4>Add/Edit Building</h4>
    <form id="building-form">
        @* @Html.AntiForgeryToken() *@
        <input type="hidden" id="building-id">
        <div class="form-grid">
            <div class="form-group"><label for="building-name">Building Name</label><input type="text" id="building-name" required></div>
            <div class="form-group"><label for="building-address">Address</label><input type="text" id="building-address" required></div>
            <div class="form-group"><label for="building-elec-rate">Electricity Rate (per kWh)</label><input type="number" step="0.01" id="building-elec-rate" value="15.00" required></div>
            <div class="form-group"><label for="building-late-fee">Late Fee (%)</label><input type="number" step="1" id="building-late-fee" value="10" required></div>
            @* --- Default Fees --- *@
            <div class="form-group"><label for="building-rent">Default Monthly Rent (₱)</label><input type="number" id="building-rent" step="0.01" value="2700" required></div>
            <div class="form-group"><label for="building-water">Default Water Fee (₱)</label><input type="number" id="building-water" step="0.01" value="100" required></div>
            <div class="form-group"><label for="building-wifi">Default WiFi Fee (₱)</label><input type="number" id="building-wifi" step="0.01" value="200" required></div>
        </div>
        <button type="submit">Save Building</button>
        <button type="button" class="btn-secondary" onclick="hideAddBuildingForm()">Cancel</button>
        <p id="building-form-message" class="message success"></p>
    </form>
</div>

@* Building List Table *@
<table>
    <thead><tr><th>Name</th><th>Address</th><th>Elec. Rate</th><th>Late Fee %</th><th>Default Rent</th><th>Default Water</th><th>Default WiFi</th><th>Actions</th></tr></thead>
    <tbody>
        @* Replace with loop over Model data *@
        <tr><td>Sunshine Apartments</td><td>123 Sunny St</td><td>₱15.00</td><td>10%</td><td>₱2700.00</td><td>₱100.00</td><td>₱200.00</td><td><button class="btn-secondary btn-small">Edit</button> <button class="btn-danger btn-small">Delete</button></td></tr>
        <tr><td>Moonlight Dorm</td><td>456 Lunar Ave</td><td>₱16.50</td><td>10%</td><td>₱3000.00</td><td>₱150.00</td><td>₱250.00</td><td><button class="btn-secondary btn-small">Edit</button> <button class="btn-danger btn-small">Delete</button></td></tr>
    </tbody>
</table>