@{
    ViewData["Title"] = "Manage Tenants";
    Layout = "_LandlordLayout";
}

<h3>
    <span><i class="fas fa-users"></i> Manage Tenants</span>
    <span class="actions"><a asp-action="AddTenant" asp-controller="Landlord" class="btn-success btn-small">Add New Tenant</a></span>
</h3>

<div class="filter-bar">
    <label for="filter-tenant-building">Building:</label>
    <select id="filter-tenant-building">
        <option value="all">All Buildings</option>
        <option value="Sunshine Apartments">Sunshine Apartments</option>
        <option value="Moonlight Dorm">Moonlight Dorm</option>
    </select>
    @* Filtering needs server logic *@
</div>

<table>
    <thead><tr><th>Name</th><th>Building</th><th>Room #</th><th>Rent</th><th>Water Fee</th><th>WiFi Fee</th><th>Actions</th></tr></thead>
    <tbody>
        @* Replace with loop over Model data *@
        <tr data-tenant-id="1"><td>Juan Dela Cruz</td><td>Sunshine Apartments</td><td>101</td><td>₱2700</td><td>₱100</td><td>₱200</td><td><button class="btn-secondary btn-small" onclick="showTenantDetails(1)">Update Fees</button> <button class="btn-danger btn-small">Remove</button></td></tr>
        <tr data-tenant-id="2"><td>Maria Clara</td><td>Sunshine Apartments</td><td>102</td><td>₱2700</td><td>₱120 <i class="fas fa-edit" title="Override: Updated 2023-10-15"></i></td><td>₱200</td><td><button class="btn-secondary btn-small" onclick="showTenantDetails(2)">Update Fees</button> <button class="btn-danger btn-small">Remove</button></td></tr>
        <tr data-tenant-id="3"><td>Crisostomo Ibarra</td><td>Moonlight Dorm</td><td>A1</td><td>₱3000</td><td>₱150</td><td>₱250</td><td><button class="btn-secondary btn-small" onclick="showTenantDetails(3)">Update Fees</button> <button class="btn-danger btn-small">Remove</button></td></tr>
    </tbody>
</table>

@* Note: The showTenantDetails(id) JS function now triggers the shared modal from _LandlordLayout *@
@* For a full detail view, you might redirect to a TenantDetail action/view instead *@