@using System.Linq
@{
    ViewData["Title"] = "Tenant Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4">Welcome to Your Tenant Dashboard</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Current Bills</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.UpcomingBills == null || !ViewBag.UpcomingBills.Any())
                    {
                        <p class="text-success">You have no outstanding bills. All payments are up to date.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var bill in ViewBag.UpcomingBills)
                            {
                                <a href="@Url.Action("BillDetails", new { id = bill.BillId })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h5 class="mb-1">Bill #@bill.BillId - @bill.TotalAmount.ToString("C")</h5>
                                        <small>
                                            @if (bill.Status == BoardPaySystem.Models.BillStatus.Overdue)
                                            {
                                                <span class="badge bg-danger">Overdue</span>
                                            }
                                            else if (bill.Status == BoardPaySystem.Models.BillStatus.NotPaid)
                                            {
                                                <span class="badge bg-warning text-dark">Not Paid</span>
                                            }
                                            else if (bill.Status == BoardPaySystem.Models.BillStatus.Pending)
                                            {
                                                <span class="badge bg-info">Pending Approval</span>
                                            }
                                        </small>
                                    </div>
                                    <p class="mb-1">Due: @bill.DueDate.ToString("MMM dd, yyyy")</p>
                                    <small>Room: @bill.Room.RoomNumber, @bill.Room.Floor.Building.BuildingName</small>
                                </a>
                            }
                        </div>
                        <div class="mt-3">
                            <a asp-action="Bills" class="btn btn-outline-primary">View All Bills</a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Recent Payments</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentPayments == null || !ViewBag.RecentPayments.Any())
                    {
                        <p>You have no payment history yet.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var payment in ViewBag.RecentPayments)
                            {
                                <a href="@Url.Action("BillDetails", new { id = payment.BillId })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h5 class="mb-1">Payment - @payment.TotalAmount.ToString("C")</h5>
                                        <small>@payment.PaymentDate?.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1">Bill #@payment.BillId for @payment.BillingDate.ToString("MMMM yyyy")</p>
                                    <small>Reference: @payment.PaymentReference</small>
                                </a>
                            }
                        </div>
                        <div class="mt-3">
                            <a asp-action="Payments" class="btn btn-outline-success">View Payment History</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Bills")" class="btn btn-outline-primary d-block h-100 p-4 text-center">
                                <i class="fas fa-file-invoice-dollar fa-3x mb-3"></i><br>
                                View Bills
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Payments")" class="btn btn-outline-success d-block h-100 p-4 text-center">
                                <i class="fas fa-history fa-3x mb-3"></i><br>
                                Payment History
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Profile")" class="btn btn-outline-secondary d-block h-100 p-4 text-center">
                                <i class="fas fa-user fa-3x mb-3"></i><br>
                                My Profile
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Notifications")" class="btn btn-outline-dark d-block h-100 p-4 text-center">
                                <i class="fas fa-bell fa-3x mb-3"></i><br>
                                Notifications
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>